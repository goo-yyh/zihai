# Neon PostgreSQL pooled connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth applications
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend transactional email (verified domain: aioff.dev)
RESEND_API_KEY=
AUTH_EMAIL_FROM="zihAI <auth@aioff.dev>"

# Vercel Blob public store token
BLOB_READ_WRITE_TOKEN=development_token

# Public canonical URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
